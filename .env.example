APP_NAME=SIMASU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:7080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database

API_BASE_URL=http://127.0.0.1:7082
# Verifikasi sertifikat TLS ke API. Set false hanya untuk development lokal.
API_VERIFY_SSL=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
ADMIN_IDLE_TIMEOUT_MINUTES=30

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=7081
